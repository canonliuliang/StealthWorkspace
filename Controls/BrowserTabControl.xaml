<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthWorkspace.Controls.BrowserTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="AddressSuggestionTemplate">
            <Grid ColumnSpacing="10" Padding="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="BookmarkStates">
                <VisualState x:Name="NotBookmarked" />
                <VisualState x:Name="Bookmarked">
                    <VisualState.Setters>
                        <Setter Target="BookmarkStarIcon.Glyph" Value="&#xE735;" />
                        <Setter Target="BookmarkStarIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Omnibox Bar (Ultra-Compact to maximize viewport) -->
        <Border x:Name="TopNavBar"
                Grid.Row="0"
                Background="{ThemeResource StealthSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Click="BackBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退 (Alt + ←)" Width="32" Height="32" Padding="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="ForwardBtn" Click="ForwardBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="前进" ToolTipService.ToolTip="前进 (Alt + →)" Width="32" Height="32" Padding="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button x:Name="ReloadStopBtn" Click="ReloadStopBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新 (F5)" Width="32" Height="32" Padding="0">
                        <FontIcon x:Name="ReloadStopIcon" Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Modern Privacy Omnibox (Address Bar) -->
                <Border Grid.Column="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4,0"
                        VerticalAlignment="Center">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Site Privacy Shield Pill with Flyout -->
                        <Button x:Name="SiteShieldBtn"
                                Grid.Column="0"
                                Padding="5,2"
                                CornerRadius="4"
                                Style="{ThemeResource SubtleButtonStyle}"
                                AutomationProperties.Name="站点隐私"
                                ToolTipService.ToolTip="隐私保护 · 登录、浏览记录和网站权限">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <icons:PrivacyShield xmlns:icons="using:StealthWorkspace.Controls" x:Name="AddressPrivacyShield" Compact="True" Width="18" Height="18" />
                                <Border x:Name="ShieldBlockedBadge" Background="{ThemeResource StealthBrandSubtleBrush}" CornerRadius="4" Padding="4,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ShieldBlockedCountText" Text="0" FontSize="12" Foreground="{ThemeResource StealthBrandBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Privacy Hub Flyout -->
                            <Button.Flyout>
                                <Flyout x:Name="PrivacyFlyout" Placement="BottomEdgeAlignedLeft" Opening="PrivacyFlyout_Opening" Opened="PrivacyFlyout_Opened" Closed="PrivacyFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="360" />
                                            <Setter Property="MaxWidth" Value="360" />
                                            <Setter Property="MaxHeight" Value="510" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                                            <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid x:Name="PrivacyContent" x:Load="False" Width="360" MaxHeight="510" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Hub Header -->
                                        <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <icons:PrivacyShield xmlns:icons="using:StealthWorkspace.Controls" Width="24" Height="24" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="FlyoutDomainText" Text="站点隐私" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SessionStateText" Text="尚未打开网页" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="DefaultProtectionText" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button x:Name="ClosePrivacyButton" Grid.Column="3" Click="CloseFlyout_Click" Style="{ThemeResource SubtleButtonStyle}" Width="32" Height="32" Padding="0" AutomationProperties.Name="关闭站点隐私" ToolTipService.ToolTip="关闭">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Segmented Tabs Row -->
                                        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <SelectorBar x:Name="PrivacySections" AutomationProperties.Name="站点隐私分类" HorizontalAlignment="Center">
                                                <SelectorBarItem x:Name="PermissionsSection" Text="权限" AutomationProperties.Name="网页权限" />
                                                <SelectorBarItem x:Name="CookiesSection" Text="登录" />
                                                <SelectorBarItem x:Name="StorageSection" Text="网站文件" AutomationProperties.Name="网站存储" />
                                                <SelectorBarItem x:Name="HistorySection" Text="浏览记录" AutomationProperties.Name="会话历史" />
                                            </SelectorBar>
                                        </Border>

                                        <!-- Panel Contents (Opaque Layer Fill) -->
                                        <Grid x:Name="PrivacyPanels" Grid.Row="2" MinHeight="300" MaxHeight="340" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                            <!-- Panel 1: Hardware & Sensor Firewall -->
                                            <ScrollViewer x:Name="PanelFirewall" Padding="16,10" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <ComboBox x:Name="PermissionScope" AutomationProperties.Name="权限适用范围" HorizontalAlignment="Stretch"
                                                              SelectionChanged="PermissionScope_SelectionChanged">
                                                        <ComboBoxItem x:Name="CurrentSiteScope" Content="本站 · 离开本站或关闭标签页后还原" />
                                                        <ComboBoxItem Content="所有网站 · 保存为默认设置" />
                                                    </ComboBox>
                                                    <TextBlock Text="开启开关会拒绝网站访问对应设备或发送通知。视频通话需要摄像头和麦克风，可仅为当前网站放行。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,2" />
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE722;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="摄像头" FontSize="14" />
                                                                <TextBlock Text="阻止网页使用摄像头" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="CameraBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页使用摄像头" ToolTipService.ToolTip="阻止此类新请求" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE720;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="麦克风" FontSize="14" />
                                                                <TextBlock Text="阻止网页使用麦克风" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="MicBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页使用麦克风" ToolTipService.ToolTip="阻止此类新请求" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE81D;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="位置信息" FontSize="14" />
                                                                <TextBlock Text="阻止网页请求精确位置" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="GeoBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页请求精确位置" ToolTipService.ToolTip="阻止此类新请求" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE7E7;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="通知" FontSize="14" />
                                                                <TextBlock Text="阻止网页发送系统通知" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="NotifyBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页发送系统通知" ToolTipService.ToolTip="阻止此类新请求" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid ColumnSpacing="12" Padding="0,10" MinHeight="56">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE77F;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="剪贴板读取" FontSize="14" />
                                                            <TextBlock Text="阻止网页静默读取剪贴板" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="已阻止" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                            <ScrollViewer x:Name="PanelCookie" Padding="12,10" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="网站登录" FontWeight="SemiBold" FontSize="16"/>
                                                    <TextBlock x:Name="AccountModeDescription" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Button x:Name="SiteCookiesOnlyButton" Click="ClearCookiesOnly_Click" AutomationProperties.Name="仅清除本站 Cookie"
                                                                IsEnabled="False" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="仅清除本站 Cookie…" TextWrapping="Wrap"/>
                                                        </Button>
                                                        <Button x:Name="AllCookiesOnlyButton" Grid.Column="1" Click="ClearCookiesOnly_Click" AutomationProperties.Name="仅清除所有 Cookie"
                                                                IsEnabled="False" HorizontalAlignment="Stretch">
                                                            <TextBlock Text="仅清除所有 Cookie…" TextWrapping="Wrap"/>
                                                        </Button>
                                                    </Grid>
                                                    <Button x:Name="ForgetSiteButton" Click="ForgetSite_Click" Content="清除本站账号和数据…" HorizontalAlignment="Stretch" />
                                                    <Button x:Name="ClearAllAccountsBtn" Click="ClearAllAccounts_Click" Content="清除所有网站账号和数据…" HorizontalAlignment="Stretch" />
                                                    <Expander Header="查看 Cookie 详情" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="这些是网站保存在本机的小记录，可能用于登录、偏好或识别设备。" FontSize="12" TextWrapping="Wrap" />
                                                            <Grid ColumnSpacing="4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBox x:Name="CookieSearchBox" PlaceholderText="搜索名称或域名" AutomationProperties.Name="搜索 Cookie 名称或域名" TextChanged="CookieSearchBox_TextChanged"/>
                                                                <Button Grid.Column="1" Click="RefreshCookies_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="刷新 Cookie 列表"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
                                                            </Grid>
                                                            <Grid MinHeight="54">
                                                                <ListView x:Name="CookieListView" SelectionMode="None" MaxHeight="180" HorizontalContentAlignment="Stretch">
                                                                    <ListView.ItemTemplate><DataTemplate>
                                                                        <Grid ColumnSpacing="6" Padding="2,4">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Domain}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                                                            <Button Grid.Column="1" Tag="{Binding}" Click="DeleteSingleCookie_Click" AutomationProperties.Name="移除此 Cookie" Style="{ThemeResource SubtleButtonStyle}"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                                                                        </Grid>
                                                                    </DataTemplate></ListView.ItemTemplate>
                                                                </ListView>
                                                                <StackPanel x:Name="CookieEmptyNotice" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="没有匹配的记录" FontSize="12"/></StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </ScrollViewer>
                                            <!-- Panel 3: Storage & Cache Purge (Truthful wording - Item 8) -->
                                            <ScrollViewer x:Name="PanelStorage" Padding="10,8" Visibility="Collapsed">
                                                <StackPanel Spacing="6">
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="本站的离线数据" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="移除这个网站的草稿、离线内容和偏好，部分网站可能要求重新登录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button x:Name="ClearSiteStorageBtn" Grid.Column="2" Content="清除…" AutomationProperties.Name="清除本站的离线数据" Click="ClearSiteStorage_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE8D7;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="所有网站的本地存储" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="包括离线文件、网站数据库和草稿" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="清除…" AutomationProperties.Name="清除所有网站的本地存储" Click="ClearAllStorage_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Action 2: Clear HTTP Cache -->
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="网页临时文件" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="保留登录状态和网页应用的离线内容" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="清除" AutomationProperties.Name="清除 网页临时文件" Click="ClearHttpCache_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Action 3: Deep Reset Site -->
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="{ThemeResource StealthBrandBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="重新加载当前页面" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="重新下载本页，保留账号和离线内容" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button x:Name="ReloadSiteFilesBtn" Grid.Column="2" Content="重载" Click="CleanReload_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- Panel 4: Volatile Session History -->
                                            <Grid x:Name="PanelHistory" Padding="10,8" RowSpacing="6" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBox x:Name="HistorySearchBox" PlaceholderText="搜索本次会话的标题或网址" AutomationProperties.Name="搜索本次会话历史" TextChanged="HistorySearchBox_TextChanged" KeyDown="HistorySearchBox_KeyDown" />
                                                <Grid Grid.Row="1">
                                                    <ListView x:Name="HistoryListView"
                                                              SelectionMode="None"
                                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                              BorderThickness="1"
                                                              CornerRadius="6">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                                    <Grid ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Url}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
                                                                            <Button AutomationProperties.Name="打开" Click="HistoryNavigate_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="打开" Padding="3">
                                                                                <FontIcon Glyph="&#xE751;" FontSize="12" />
                                                                            </Button>
                                                                            <Button AutomationProperties.Name="删除" Click="HistoryDelete_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="删除" Padding="3">
                                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <StackPanel x:Name="HistoryEmptyNotice" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="Collapsed">
                                                        <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="HistoryEmptyText" Text="本次还没有浏览记录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Button Grid.Row="2" Content="清空本次浏览记录" HorizontalAlignment="Stretch" Click="ClearSessionHistory_Click" CornerRadius="4" Padding="4,4" FontSize="12" />
                                            </Grid>
                                        </Grid>

                                        <!-- Hub Footer -->
                                        <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Name="HubStatusText" Text="输入网址或关键词后开始浏览。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Column 1: URL Text Box -->
                        <AutoSuggestBox x:Name="UrlTextBox"
                                 Grid.Column="1"
                                 PlaceholderText="搜索或输入网址"
                                 AutomationProperties.Name="地址栏"
                                 KeyDown="UrlTextBox_KeyDown"
                                 GotFocus="UrlTextBox_GotFocus"
                                 LostFocus="AddressLostFocus"
                                 TextChanged="AddressTextChanged"
                                 QuerySubmitted="AddressQuerySubmitted"
                                 SuggestionChosen="AddressSuggestionChosen"
                                 TextMemberPath="Input"
                                 MaxSuggestionListHeight="360"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 Padding="4,6"
                                 FontSize="14"
                                 VerticalAlignment="Center" ItemTemplate="{StaticResource AddressSuggestionTemplate}" />



                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="PopupBlockedBtn" Visibility="Collapsed" Click="PopupBlockedBtn_Click"
                            Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="被拦截的弹窗"
                            Width="32" Height="32" Padding="0" ToolTipService.ToolTip="查看被拦截的弹窗">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                <Button x:Name="DownloadsBtn" Click="ShowDownloads_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="下载" ToolTipService.ToolTip="下载 (Ctrl+J)" MinWidth="32" Height="32" Padding="5,0">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                        <Border x:Name="DownloadCountBadge" Visibility="Collapsed" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="4,0">
                            <TextBlock x:Name="DownloadCountText" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="BrowserMenuBtn" VerticalAlignment="Center"
                        Style="{ThemeResource SubtleButtonStyle}"
                        AutomationProperties.Name="浏览器更多操作" ToolTipService.ToolTip="更多操作"
                        Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="MoreActionsFlyout" Placement="BottomEdgeAlignedRight" Opening="MoreActionsFlyout_Opening" Closed="MoreActionsFlyout_Closed">
                            <StackPanel x:Name="MoreActionsContent" x:Load="False" Width="248" Spacing="2">
                                <Grid x:Name="ZoomMenuRow" ColumnSpacing="6" Padding="8,2,2,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ZoomMenuLabel" Text="网页缩放" VerticalAlignment="Center" />
                                    <Button x:Name="ZoomMenuMinus" Grid.Column="1" Content="−" AutomationProperties.Name="缩小" ToolTipService.ToolTip="缩小 (Ctrl+−)" Click="ZoomOutBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button Grid.Column="2" x:Name="ZoomResetBtn" Content="100%" AutomationProperties.Name="重置缩放" ToolTipService.ToolTip="重置缩放 (Ctrl+0)" Click="ZoomResetBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button x:Name="ZoomMenuPlus" Grid.Column="3" Content="+" AutomationProperties.Name="放大" ToolTipService.ToolTip="放大 (Ctrl++)" Click="ZoomInBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,3" />
                                <Button x:Name="OpenInEdgeBtn" Content="在 Edge 隐私窗口打开" AutomationProperties.HelpText="打开独立的 Edge InPrivate 窗口。关闭 Stealth 不会关闭该窗口。" Click="OpenInEdge_Click" ToolTipService.ToolTip="新标签打开空白隐私窗口；网页打开当前地址。Edge 的窗口需要单独关闭。" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <StackPanel x:Name="PageActionsGroup" Spacing="2">
                                    <TextBlock x:Name="PageActionsHint" Text="打开网页后可使用以下操作" TextWrapping="Wrap" Margin="10,5,8,2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="FindMenuButton" Content="页内查找    Ctrl+F" Click="FindInPageBtn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button x:Name="PageImagesBtn" Content="查看网页图片" Click="PageImages_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button x:Name="CopyCleanLinkBtn" Content="复制净化链接" Click="CopyCleanLink_Click" AutomationProperties.HelpText="仅移除已知跟踪参数，保留网页地址和其他参数" ToolTipService.ToolTip="仅移除已知跟踪参数，保留其他参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button x:Name="HardReloadMenuButton" AutomationProperties.Name="重新获取此页资源，保留当前登录与其他标签页" Content="忽略缓存并刷新    Ctrl+Shift+R" Click="HardReload_Click" ToolTipService.ToolTip="重新获取此页资源，保留当前登录与其他标签页" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button x:Name="AudioMuteBtn" Content="静音标签页" Click="AudioMuteBtn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,3" />
                                </StackPanel>
                                <Button x:Name="SessionHistoryMenuButton" Content="本次会话历史 (Ctrl+H)" Click="ShowHistory_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button x:Name="FolderMenuButton" Content="打开下载文件夹" Click="OpenDownloadsFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="BookmarkBar" Margin="0,6,0,0" ColumnSpacing="6" Loaded="BookmarkBar_Loaded" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BookmarkBarEntries" Spacing="3" Orientation="Horizontal" />
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="BookmarkStarBtn"

                                Click="BookmarkStarBtn_Click"
                                Padding="4,2"
                                CornerRadius="4"
                                Style="{ThemeResource SubtleButtonStyle}"
                                AutomationProperties.Name="收藏本页"
                                ToolTipService.ToolTip="收藏本页">
                            <FontIcon x:Name="BookmarkStarIcon" Glyph="&#xE734;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    <Button x:Name="FavoritesBtn" VerticalAlignment="Center"
                        Style="{ThemeResource SubtleButtonStyle}"
                        AutomationProperties.Name="收藏夹" ToolTipService.ToolTip="收藏夹"
                        Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE728;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="BookmarksFlyout" Placement="BottomEdgeAlignedRight" Opening="BookmarksFlyout_Opening" Closed="BookmarksFlyout_Closed">
                            <Grid x:Name="BookmarksContent" x:Load="False" Width="340" MaxHeight="440">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="4,0,4,8">
                                    <TextBlock Text="收藏夹" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                    <Button Content="管理收藏" HorizontalAlignment="Right" Click="ManageBookmarks_Click" />
                                </Grid>
                                <TextBox x:Name="BookmarkSearchBox" Grid.Row="1" PlaceholderText="搜索收藏名称或网址" AutomationProperties.Name="搜索收藏" MaxLength="200" Margin="4,0,4,8" TextChanged="BookmarkSearch_Changed" />
                                <ListView x:Name="BookmarksListView" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="6" Padding="4,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Click="BookmarkItem_Click" PointerPressed="BookmarkItem_PointerPressed" Tag="{Binding}" AutomationProperties.Name="{Binding Title}" ToolTipService.ToolTip="{Binding Url}" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Url}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Click="BookmarkOptions_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="收藏选项" ToolTipService.ToolTip="收藏选项" Width="32" Height="32" Padding="0">
                                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="BookmarksEmptyText" Grid.Row="2" Text="还没有收藏的网页" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                                    <Button x:Name="ManageBarBookmarks" Content="整理" Click="ManageBookmarks_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="整理收藏夹栏" Padding="7,2"/>
                </StackPanel>
            </Grid>
            </StackPanel>
        </Border>

        <!-- Floating In-Page Find Bar (Ctrl + F - Item 12) -->
        <Border x:Name="FindBar"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4"
                Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox"
                         AutomationProperties.Name="查找网页内容"
                         Grid.Column="1"
                         PlaceholderText="查找网页内容..."
                         Padding="6,2"
                         FontSize="12"
                         KeyDown="FindTextBox_KeyDown"
                         TextChanged="FindTextBox_TextChanged"
                         VerticalAlignment="Center" />
                <Button AutomationProperties.Name="下一个 (Enter)" Grid.Column="2" Click="FindNextBtn_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="下一个 (Enter)" Padding="5,3">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button AutomationProperties.Name="上一个 (Shift+Enter)" Grid.Column="3" Click="FindPrevBtn_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="上一个 (Shift+Enter)" Padding="5,3">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ToggleButton x:Name="FindCaseToggle" Content="Aa" AutomationProperties.Name="区分大小写" ToolTipService.ToolTip="区分大小写" Checked="FindCaseToggle_Changed" Unchecked="FindCaseToggle_Changed" Padding="6,2" />
                    <TextBlock x:Name="FindStatusText" Text="" MinWidth="60" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button AutomationProperties.Name="关闭 (Esc)" Grid.Column="5" Click="CloseFindBar_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="关闭 (Esc)" Padding="5,3">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <InfoBar x:Name="BrowserErrorBar" Grid.Row="2" Severity="Error" IsOpen="False">
            <InfoBar.ActionButton>
                <Button Content="重试" Click="RefreshBtn_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- WebView2 Browser Control: Maximized Viewport Area -->
        <Grid Grid.Row="3">
            <Grid x:Name="BrowserHost" />
            <ProgressBar x:Name="BrowserProgressBar" VerticalAlignment="Top" Height="2" Canvas.ZIndex="10"
                         IsHitTestVisible="False" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="正在加载网页" />

            <Border x:Name="ZoomPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Padding="6" CornerRadius="8" Canvas.ZIndex="30"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ZoomPanelMinus" Content="−" Click="ZoomOutBtn_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="缩小页面" />
                    <Button x:Name="ZoomPanelReset" Content="100%" Click="ZoomResetBtn_Click" MinWidth="64" Height="32" Padding="6,0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="重置缩放" />
                    <Button x:Name="ZoomPanelPlus" Content="+" Click="ZoomInBtn_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="放大页面" />
                    <Button Click="CloseZoomPanel_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="关闭缩放面板"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                </StackPanel>
            </Border>

            <Border x:Name="StartSurface" Background="{ThemeResource StealthCanvasBrush}">
                <ScrollViewer x:Name="StartPageScroller" SizeChanged="StartPageScroller_SizeChanged" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <StackPanel x:Name="StartContent" MaxWidth="740" Margin="24,36" Spacing="22"
                                    VerticalAlignment="Top" HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/AppIcon.png" Width="34" Height="34" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Grid.Column="1" Text="新标签页" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Click="OpenDownloadsFolder_Click" AutomationProperties.Name="打开下载文件夹">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="15"/><TextBlock Text="下载文件夹"/></StackPanel>
                                </Button>
                            </Grid>
                            <Border CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                                <StackPanel Spacing="8">
                                    <AutoSuggestBox x:Name="StartSearchBox" PlaceholderText="搜索或输入网址" QueryIcon="Find" FontSize="16" MinHeight="44"
                                                    AutomationProperties.Name="搜索或输入网址" TextChanged="AddressTextChanged" QuerySubmitted="AddressQuerySubmitted"
                                                    SuggestionChosen="AddressSuggestionChosen" TextMemberPath="Input" ItemTemplate="{StaticResource AddressSuggestionTemplate}"/>
                                    <Button x:Name="SearchHomeBtn" Click="HomeBtn_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="6,2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE774;" FontSize="13"/><TextBlock Text="打开搜索引擎首页" FontSize="12"/></StackPanel>
                                    </Button>
                                    <TextBlock x:Name="StartMessage" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Download Interception Toast Notification (Item 11) -->
            <Border x:Name="DownloadToast"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Visibility="Collapsed"
                    Canvas.ZIndex="20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon x:Name="DownloadToastIcon" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="DownloadToastTitle" Text="下载文件" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="360" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="DownloadToastDesc" Text="文件保存在应用下载文件夹，未自动加密。" FontSize="12" TextWrapping="Wrap" MaxWidth="360" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="DownloadVaultActions" Visibility="Collapsed" Spacing="4">
                            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MaxWidth="360" />
                            <Button Content="加密入库并粉碎原件" Click="StoreDownload_Click" IsEnabled="{Binding CanStore}" Visibility="{Binding StoreVisibility}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="查看" Click="ShowDownloads_Click" Style="{ThemeResource SubtleButtonStyle}" />
                    <Button Click="DismissDownloadToast_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="4" AutomationProperties.Name="关闭下载提示">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
