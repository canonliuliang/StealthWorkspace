<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="StealthWorkspace.Controls.BrowserTabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="AddressSuggestionTemplate">
            <Grid ColumnSpacing="10" Padding="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Omnibox Bar (Ultra-Compact to maximize viewport) -->
        <Border x:Name="TopNavBar"
                Grid.Row="0"
                Background="{ThemeResource StealthSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Click="BackBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="后退" ToolTipService.ToolTip="后退 (Alt + ←)" Width="32" Height="32" Padding="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="ForwardBtn" Click="ForwardBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="前进" ToolTipService.ToolTip="前进 (Alt + →)" Width="32" Height="32" Padding="0" IsEnabled="False">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button x:Name="ReloadStopBtn" Click="ReloadStopBtn_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新 (F5)" Width="32" Height="32" Padding="0">
                        <FontIcon x:Name="ReloadStopIcon" Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Modern Privacy Omnibox (Address Bar) -->
                <Border Grid.Column="1"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4,0"
                        VerticalAlignment="Center">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Site Privacy Shield Pill with Flyout -->
                        <Button x:Name="SiteShieldBtn"
                                Grid.Column="0"
                                Padding="5,2"
                                CornerRadius="4"
                                Style="{ThemeResource SubtleButtonStyle}"
                                AutomationProperties.Name="站点隐私"
                                ToolTipService.ToolTip="站点隐私与权限">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                                <Border x:Name="ShieldBlockedBadge" Background="{ThemeResource StealthBrandSubtleBrush}" CornerRadius="4" Padding="4,0" Visibility="Collapsed">
                                    <TextBlock x:Name="ShieldBlockedCountText" Text="0" FontSize="12" Foreground="{ThemeResource StealthBrandBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Privacy Hub Flyout -->
                            <Button.Flyout>
                                <Flyout x:Name="PrivacyFlyout" Placement="BottomEdgeAlignedLeft" Opening="PrivacyFlyout_Opening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="360" />
                                            <Setter Property="MaxWidth" Value="360" />
                                            <Setter Property="MaxHeight" Value="510" />
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                                            <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <Grid x:Name="PrivacyContent" x:Load="False" Width="360" MaxHeight="510" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Hub Header -->
                                        <Border Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="FlyoutDomainText" Text="站点隐私" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SessionStateText" Text="尚未打开网页" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Click="CloseFlyout_Click" Style="{ThemeResource SubtleButtonStyle}" Width="32" Height="32" Padding="0" AutomationProperties.Name="关闭站点隐私" ToolTipService.ToolTip="关闭">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Segmented Tabs Row -->
                                        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid ColumnSpacing="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="TabFirewallBtn" AutomationProperties.Name="网页权限" Grid.Column="0" Click="TabFirewall_Click"
                                                        HorizontalAlignment="Stretch" Height="32" Padding="4,0" CornerRadius="4"
                                                        Style="{ThemeResource AccentButtonStyle}">
                                                    <TextBlock Text="权限" FontSize="12" FontWeight="SemiBold" />
                                                </Button>

                                                <Button x:Name="TabCookieBtn" AutomationProperties.Name="Cookie" Grid.Column="1" Click="TabCookie_Click"
                                                        HorizontalAlignment="Stretch" Height="32" Padding="4,0" CornerRadius="4"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                    <TextBlock Text="Cookie" FontSize="12" />
                                                </Button>

                                                <Button x:Name="TabStorageBtn" AutomationProperties.Name="网站存储" Grid.Column="2" Click="TabStorage_Click"
                                                        HorizontalAlignment="Stretch" Height="32" Padding="4,0" CornerRadius="4"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                    <TextBlock Text="存储" FontSize="12" />
                                                </Button>

                                                <Button x:Name="TabHistoryBtn" AutomationProperties.Name="会话历史" Grid.Column="3" Click="TabHistory_Click"
                                                        HorizontalAlignment="Stretch" Height="32" Padding="4,0" CornerRadius="4"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                    <TextBlock Text="历史" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Panel Contents (Opaque Layer Fill) -->
                                        <Grid Grid.Row="2" MinHeight="300" MaxHeight="340" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                            <!-- Panel 1: Hardware & Sensor Firewall -->
                                            <ScrollViewer x:Name="PanelFirewall" Padding="16,10" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <TextBlock Text="开启开关即可阻止相应权限" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE722;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="摄像头" FontSize="14" />
                                                                <TextBlock Text="阻止网页使用摄像头" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="CameraBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页使用摄像头" ToolTipService.ToolTip="开启：阻止；关闭：允许" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE720;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="麦克风" FontSize="14" />
                                                                <TextBlock Text="阻止网页使用麦克风" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="MicBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页使用麦克风" ToolTipService.ToolTip="开启：阻止；关闭：允许" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE81D;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="位置信息" FontSize="14" />
                                                                <TextBlock Text="阻止网页请求精确位置" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="GeoBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页请求精确位置" ToolTipService.ToolTip="开启：阻止；关闭：允许" />
                                                        </Grid>
                                                    </Border>
                                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                        <Grid ColumnSpacing="12" MinHeight="36">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE7E7;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="通知" FontSize="14" />
                                                                <TextBlock Text="阻止网页发送系统通知" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <ToggleSwitch x:Name="NotifyBlockToggle" Grid.Column="2" Toggled="PermissionToggle_Toggled" IsOn="True" OnContent="" OffContent="" MinWidth="0" Width="48" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="阻止网页发送系统通知" ToolTipService.ToolTip="开启：阻止；关闭：允许" />
                                                        </Grid>
                                                    </Border>
                                                    <Grid ColumnSpacing="12" Padding="0,10" MinHeight="56">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE77F;" FontSize="18" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="剪贴板读取" FontSize="14" />
                                                            <TextBlock Text="阻止网页静默读取剪贴板" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="已阻止" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
<!-- Panel 2: Cookie Inspector & Manager -->
                                            <Grid x:Name="PanelCookie" Padding="10,8" RowSpacing="6" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Search & Refresh -->
                                                <Grid Grid.Row="0" ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="CookieSearchBox"
                                                             AutomationProperties.Name="搜索 Cookie 名称或域名"
                                                             PlaceholderText="搜索 Cookie 名称或域名..."
                                                             TextChanged="CookieSearchBox_TextChanged"
                                                             Padding="6,3"
                                                             FontSize="12"
                                                             CornerRadius="4" />
                                                    <Button AutomationProperties.Name="刷新" Grid.Column="1" Click="RefreshCookies_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="6,4" ToolTipService.ToolTip="刷新">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                    </Button>
                                                </Grid>

                                                <!-- Cookie List -->
                                                <Grid Grid.Row="1">
                                                    <ListView x:Name="CookieListView"
                                                              SelectionMode="None"
                                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                              BorderThickness="1"
                                                              CornerRadius="6">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                                    <Grid ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="3,0" Visibility="{Binding SecureBadgeVisibility}">
                                                                                    <TextBlock Text="Sec" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                                                </Border>
                                                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="3,0" Visibility="{Binding HttpOnlyBadgeVisibility}">
                                                                                    <TextBlock Text="Http" FontSize="12" Foreground="Orange" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Domain}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <Button AutomationProperties.Name="删除" Grid.Column="1" Click="DeleteSingleCookie_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="删除" Padding="4">
                                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <StackPanel x:Name="CookieEmptyNotice" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="Collapsed">
                                                        <FontIcon Glyph="&#xE765;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="暂无隔离 Cookie" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Actions -->
                                                <Grid Grid.Row="2" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="清除本站 Cookie" HorizontalAlignment="Stretch" Click="DeleteSiteCookies_Click" CornerRadius="4" Padding="4,4" FontSize="12" />
                                                    <Button Grid.Column="1" Content="清空所有 Cookie" HorizontalAlignment="Stretch" Click="DeleteAllCookies_Click" CornerRadius="4" Padding="4,4" FontSize="12" />
                                                </Grid>
                                            </Grid>

                                            <!-- Panel 3: Storage & Cache Purge (Truthful wording - Item 8) -->
                                            <ScrollViewer x:Name="PanelStorage" Padding="10,8" Visibility="Collapsed">
                                                <StackPanel Spacing="6">
                                                    <!-- Action 1: Clear LocalStorage / IndexedDB / Cache -->
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE8D7;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="清空本地存储与脚本缓存" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="清除 LocalStorage / IndexedDB / CacheStorage（不含 Cookie）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="立即清空" Click="ClearAllStorage_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Action 2: Clear HTTP Cache -->
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="清空临时网络与脚本缓存" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="释放磁盘与内存中暂存的静态资源" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="清空" Click="ClearHttpCache_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Action 3: Deep Reset Site -->
                                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="{ThemeResource StealthBrandBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="重新加载当前页面" FontWeight="SemiBold" FontSize="12" />
                                                                <TextBlock Text="重新请求本页内容，不会清除 Cookie 与存储" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="重载" Click="CleanReload_Click" CornerRadius="4" Padding="8,4" FontSize="12" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- Panel 4: Volatile Session History -->
                                            <Grid x:Name="PanelHistory" Padding="10,8" RowSpacing="6" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <ListView x:Name="HistoryListView"
                                                              SelectionMode="None"
                                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                              BorderThickness="1"
                                                              CornerRadius="6">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                                                                    <Grid ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Url}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1">
                                                                            <Button AutomationProperties.Name="打开" Click="HistoryNavigate_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="打开" Padding="3">
                                                                                <FontIcon Glyph="&#xE751;" FontSize="12" />
                                                                            </Button>
                                                                            <Button AutomationProperties.Name="删除" Click="HistoryDelete_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="删除" Padding="3">
                                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <StackPanel x:Name="HistoryEmptyNotice" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="Collapsed">
                                                        <FontIcon Glyph="&#xE81C;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="暂无内存会话历史" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Button Grid.Row="1" Content="清空当前临时历史" HorizontalAlignment="Stretch" Click="ClearSessionHistory_Click" CornerRadius="4" Padding="4,4" FontSize="12" />
                                            </Grid>
                                        </Grid>

                                        <!-- Hub Footer -->
                                        <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock x:Name="HubStatusText" Text="输入网址或关键词后开始浏览。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Column 1: URL Text Box -->
                        <AutoSuggestBox x:Name="UrlTextBox"
                                 Grid.Column="1"
                                 PlaceholderText="搜索或输入网址"
                                 AutomationProperties.Name="地址栏"
                                 KeyDown="UrlTextBox_KeyDown"
                                 GotFocus="UrlTextBox_GotFocus"
                                 TextChanged="AddressTextChanged"
                                 QuerySubmitted="AddressQuerySubmitted"
                                 SuggestionChosen="AddressSuggestionChosen"
                                 TextMemberPath="Input"
                                 MaxSuggestionListHeight="360"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 Padding="4,6"
                                 FontSize="14"
                                 VerticalAlignment="Center" ItemTemplate="{StaticResource AddressSuggestionTemplate}" />

                        <!-- Column 2: Bookmark Star Toggle (Item 13) -->
                        <Button x:Name="BookmarkStarBtn"
                                Grid.Column="2"
                                Click="BookmarkStarBtn_Click"
                                Padding="4,2"
                                CornerRadius="4"
                                Style="{ThemeResource SubtleButtonStyle}"
                                AutomationProperties.Name="收藏本页"
                                ToolTipService.ToolTip="收藏本页">
                            <FontIcon x:Name="BookmarkStarIcon" Glyph="&#xE734;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="PopupBlockedBtn" Visibility="Collapsed" Click="PopupBlockedBtn_Click"
                            Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="被拦截的弹窗"
                            Width="32" Height="32" Padding="0" ToolTipService.ToolTip="查看被拦截的弹窗">
                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                    </Button>
                <Button x:Name="FavoritesBtn" VerticalAlignment="Center"
                        Style="{ThemeResource SubtleButtonStyle}"
                        AutomationProperties.Name="收藏夹" ToolTipService.ToolTip="收藏夹"
                        Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE728;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="BookmarksFlyout" Placement="BottomEdgeAlignedRight" Opening="BookmarksFlyout_Opening" Closed="BookmarksFlyout_Closed">
                            <Grid x:Name="BookmarksContent" x:Load="False" Width="340" MaxHeight="440">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="4" Margin="4,0,4,12">
                                    <TextBlock Text="收藏夹" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="点击地址栏的星标收藏网页（Ctrl+D）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="BookmarkSearchBox" Grid.Row="1" PlaceholderText="搜索收藏名称或网址" AutomationProperties.Name="搜索收藏" MaxLength="200" Margin="4,0,4,8" TextChanged="BookmarkSearch_Changed" />
                                <ListView x:Name="BookmarksListView" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch">
                                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="6" Padding="4,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Click="BookmarkItem_Click" PointerPressed="BookmarkItem_PointerPressed" Tag="{Binding}" AutomationProperties.Name="{Binding Title}" ToolTipService.ToolTip="{Binding Url}" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Url}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" Click="BookmarkOptions_Click" Tag="{Binding}" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="收藏选项" ToolTipService.ToolTip="收藏选项" Width="32" Height="32" Padding="0">
                                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="BookmarksEmptyText" Grid.Row="2" Text="还没有收藏的网页" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed" />
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="DownloadsBtn" Click="ShowDownloads_Click" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="下载" ToolTipService.ToolTip="下载 (Ctrl+J)" Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                </Button>
                <Button x:Name="BrowserMenuBtn" VerticalAlignment="Center"
                        Style="{ThemeResource SubtleButtonStyle}"
                        AutomationProperties.Name="浏览器更多操作" ToolTipService.ToolTip="更多操作"
                        Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="MoreActionsFlyout" Placement="BottomEdgeAlignedRight" Opening="MoreActionsFlyout_Opening" Closed="MoreActionsFlyout_Closed">
                            <StackPanel x:Name="MoreActionsContent" x:Load="False" Width="260" Spacing="4">
                                <Button Content="页内查找    Ctrl+F" Click="FindInPageBtn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button x:Name="PageImagesBtn" Content="查看网页图片" Click="PageImages_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button AutomationProperties.Name="重新获取此页资源，保留当前登录与其他标签页" Content="忽略缓存并刷新    Ctrl+Shift+R" Click="HardReload_Click" ToolTipService.ToolTip="重新获取此页资源，保留当前登录与其他标签页" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button Content="本次会话历史" Click="ShowHistory_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button AutomationProperties.Name="转到独立的 Edge InPrivate 窗口；本应用的锁定和结束会话不会关闭它。" x:Name="OpenInEdgeBtn" Content="在 Edge 隐私窗口打开" Click="OpenInEdge_Click" ToolTipService.ToolTip="转到独立的 Edge InPrivate 窗口；本应用的锁定和结束会话不会关闭它。" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button Content="打开下载文件夹" Click="OpenDownloadsFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Button x:Name="AudioMuteBtn" Content="静音标签页" Click="AudioMuteBtn_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{ThemeResource SubtleButtonStyle}" />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,6" />
                                <Grid x:Name="ZoomMenuRow" ColumnSpacing="6" Padding="8,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="缩放" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="−" AutomationProperties.Name="缩小" ToolTipService.ToolTip="缩小 (Ctrl+−)" Click="ZoomOutBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button Grid.Column="2" x:Name="ZoomResetBtn" Content="100%" AutomationProperties.Name="重置缩放" ToolTipService.ToolTip="重置缩放 (Ctrl+0)" Click="ZoomResetBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                    <Button Grid.Column="3" Content="+" AutomationProperties.Name="放大" ToolTipService.ToolTip="放大 (Ctrl++)" Click="ZoomInBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Floating In-Page Find Bar (Ctrl + F - Item 12) -->
        <Border x:Name="FindBar"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4"
                Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="FindTextBox"
                         AutomationProperties.Name="查找网页内容"
                         Grid.Column="1"
                         PlaceholderText="查找网页内容..."
                         Padding="6,2"
                         FontSize="12"
                         KeyDown="FindTextBox_KeyDown"
                         TextChanged="FindTextBox_TextChanged"
                         VerticalAlignment="Center" />
                <Button AutomationProperties.Name="下一个 (Enter)" Grid.Column="2" Click="FindNextBtn_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="下一个 (Enter)" Padding="5,3">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>
                <Button AutomationProperties.Name="上一个 (Shift+Enter)" Grid.Column="3" Click="FindPrevBtn_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="上一个 (Shift+Enter)" Padding="5,3">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ToggleButton x:Name="FindCaseToggle" Content="Aa" AutomationProperties.Name="区分大小写" ToolTipService.ToolTip="区分大小写" Checked="FindCaseToggle_Changed" Unchecked="FindCaseToggle_Changed" Padding="6,2" />
                    <TextBlock x:Name="FindStatusText" Text="" MinWidth="60" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button AutomationProperties.Name="关闭 (Esc)" Grid.Column="5" Click="CloseFindBar_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="关闭 (Esc)" Padding="5,3">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <InfoBar x:Name="BrowserErrorBar" Grid.Row="2" Severity="Error" IsOpen="False">
            <InfoBar.ActionButton>
                <Button Content="重试" Click="RefreshBtn_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ProgressBar x:Name="BrowserProgressBar"
                     Grid.Row="3"
                     VerticalAlignment="Top"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Height="2"
                     Canvas.ZIndex="10" />

        <!-- WebView2 Browser Control: Maximized Viewport Area -->
        <Grid Grid.Row="4">
            <Grid x:Name="BrowserHost" />

            <Border x:Name="ZoomPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Padding="6" CornerRadius="8" Canvas.ZIndex="30"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ZoomPanelMinus" Content="−" Click="ZoomOutBtn_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="缩小页面" />
                    <Button x:Name="ZoomPanelReset" Content="100%" Click="ZoomResetBtn_Click" MinWidth="64" Height="32" Padding="6,0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="重置缩放" />
                    <Button x:Name="ZoomPanelPlus" Content="+" Click="ZoomInBtn_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="放大页面" />
                    <Button Click="CloseZoomPanel_Click" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="关闭缩放面板"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                </StackPanel>
            </Border>

            <Border x:Name="StartSurface" Background="{ThemeResource StealthCanvasBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                <StackPanel Spacing="28" MaxWidth="680" Margin="32,40" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                            <Image Source="ms-appx:///Assets/AppIcon.png" Width="52" Height="52" AutomationProperties.Name="Stealth" />
                            <TextBlock Text="Stealth" FontSize="38" CharacterSpacing="45" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="留一处空间，专注于此刻。" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="12">
                    <AutoSuggestBox x:Name="StartSearchBox" PlaceholderText="搜索或输入网址" QueryIcon="Find" FontSize="16" Padding="16,14" CornerRadius="12"
                                    AutomationProperties.Name="搜索或输入网址" TextChanged="AddressTextChanged" QuerySubmitted="AddressQuerySubmitted"
                                    SuggestionChosen="AddressSuggestionChosen" TextMemberPath="Input" ItemTemplate="{StaticResource AddressSuggestionTemplate}" />
                    <TextBlock x:Name="StartMessage" Text="切换功能保留网页；锁定或结束会话时清除本次浏览数据。" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="常用收藏" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="查看全部" Click="ShowFavorites_Click" HorizontalAlignment="Right" Style="{ThemeResource SubtleButtonStyle}" />
                        </Grid>
                        <ItemsControl x:Name="StartBookmarks">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="BookmarkItem_Click" PointerPressed="BookmarkItem_PointerPressed" Tag="{Binding}" AutomationProperties.Name="{Binding Title}" Width="148" Height="84" Margin="0,0,12,12" HorizontalContentAlignment="Stretch" Padding="14" CornerRadius="10" ToolTipService.ToolTip="{Binding Url}">
                                    <StackPanel Spacing="8">
                                        <FontIcon Glyph="&#xE734;" FontSize="18" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Visibility="{Binding Visibility, ElementName=StartBookmarksEmpty}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <TextBlock x:Name="StartBookmarksEmpty" Text="喜欢的网页，留在手边。点击地址栏的星标，即可添加收藏。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button x:Name="SearchHomeBtn" Content="搜索首页" Click="HomeBtn_Click" Style="{ThemeResource SubtleButtonStyle}" />
                        <Button Content="下载文件夹" Click="OpenDownloadsFolder_Click" Style="{ThemeResource SubtleButtonStyle}" />
                    </StackPanel>
                    <TextBlock Text="Ctrl+L 地址栏  ·  Ctrl+T 新标签  ·  Ctrl+Shift+T 恢复关闭标签" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- Download Interception Toast Notification (Item 11) -->
            <Border x:Name="DownloadToast"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Visibility="Collapsed"
                    Canvas.ZIndex="20">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="DownloadToastTitle" Text="下载文件" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        <TextBlock x:Name="DownloadToastDesc" Text="文件保存在应用下载文件夹，未自动加密。" FontSize="12" TextWrapping="Wrap" MaxWidth="360" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Content="查看" Click="ShowDownloads_Click" Style="{ThemeResource SubtleButtonStyle}" />
                    <Button Click="DismissDownloadToast_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="4" AutomationProperties.Name="关闭下载提示">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
