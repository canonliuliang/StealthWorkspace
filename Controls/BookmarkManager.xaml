<UserControl x:Class="StealthWorkspace.Controls.BookmarkManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:StealthWorkspace.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="14,12" RowSpacing="8" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="整理收藏夹栏" Style="{ThemeResource SubtitleTextBlockStyle}"/><Button HorizontalAlignment="Right" AutomationProperties.Name="关闭收藏夹" ToolTipService.ToolTip="关闭收藏夹" Click="Close_Click" Style="{ThemeResource SubtleButtonStyle}"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid>
        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="Up" Click="Up_Click" AutomationProperties.Name="返回上一级文件夹" ToolTipService.ToolTip="返回上一级" Width="32" Height="32" Padding="0"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
            <TextBlock x:Name="Location" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="Create" Click="Create_Click" Content="新建文件夹" />
        </Grid>
        <TextBox Grid.Row="2" x:Name="Filter" PlaceholderText="搜索全部收藏和文件夹" AutomationProperties.Name="搜索全部收藏和文件夹" TextChanged="Filter_Changed"/>
        <Grid Grid.Row="4">
            <ListView x:Name="Rows" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Row_Click" HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,2"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate x:DataType="local:BookmarkManagerEntry"><Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon FontSize="17" Glyph="{x:Bind Glyph}"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                        <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <Button Grid.Column="2" Tag="{x:Bind}" Click="Edit_Click" Width="32" Height="32" Padding="0"
                        AutomationProperties.Name="{x:Bind ActionName}" ToolTipService.ToolTip="编辑、移动或删除" Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                    </Button>
                </Grid></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" Text="这个文件夹还没有收藏" Margin="4,16" IsHitTestVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="370"><StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AddLink" Content="添加链接" Click="AddLink_Click" Style="{ThemeResource AccentButtonStyle}"/><Button x:Name="ImportButton" Content="从 Chrome 导入" Click="Import_Click"/><Button x:Name="ExportButton" Content="导出" Click="Export_Click"/></StackPanel>
            <StackPanel x:Name="Editor" Visibility="Collapsed" Spacing="8">
                <TextBox x:Name="EntryName" Header="名称" MaxLength="200"/>
                <TextBox x:Name="Address" Header="网址" PlaceholderText="https://" Visibility="Collapsed"/>
                <ComboBox x:Name="ParentFolder" Header="保存到" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="Save" Content="保存" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click"/>
                    <Button Content="取消" Click="CancelEdit_Click"/>
                    <Button x:Name="Delete" Content="删除" Click="Delete_Click"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="Feedback" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
