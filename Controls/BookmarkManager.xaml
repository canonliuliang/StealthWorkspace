<UserControl x:Class="StealthWorkspace.Controls.BookmarkManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StealthWorkspace.Controls"
    KeyDown="Manager_KeyDown">
    <Grid Padding="12,12,10,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="收藏夹" FontSize="17" FontWeight="SemiBold" Margin="3,0" VerticalAlignment="Center"/>
            <Button x:Name="MoreActions" Grid.Column="1" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="导入和导出收藏" AutomationProperties.Name="导入和导出收藏">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                <Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem x:Name="ImportButton" Text="从 Chrome 导入…" Click="Import_Click"/>
                    <MenuFlyoutItem x:Name="ExportButton" Text="导出为 HTML…" Click="Export_Click"/>
                </MenuFlyout></Button.Flyout>
            </Button>
            <Button x:Name="CloseRail" Grid.Column="2" Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="收起收藏夹" AutomationProperties.Name="收起收藏夹" Click="Close_Click">
                <FontIcon Glyph="&#xE974;" FontSize="15"/>
            </Button>
        </Grid>
        <Grid Grid.Row="1" x:Name="SearchRow">
            <TextBox x:Name="Filter" Padding="32,5,8,5" MaxLength="200" PlaceholderText="搜索收藏"
                     AutomationProperties.Name="搜索全部收藏和文件夹" TextChanged="Filter_Changed"/>
            <FontIcon Margin="10,0" HorizontalAlignment="Left" IsHitTestVisible="False" Glyph="&#xE721;" FontSize="13"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="4" x:Name="Actions">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="CurrentPage" HorizontalAlignment="Stretch" Click="CurrentPage_Click" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE734;" FontSize="14"/><TextBlock x:Name="CurrentLabel" Text="收藏本页" FontSize="13"/></StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="AddLink" Width="34" Height="32" Padding="0" Click="AddLink_Click"
                    Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="添加链接" AutomationProperties.Name="添加链接">
                <FontIcon Glyph="&#xE71B;" FontSize="15"/>
            </Button>
            <Button Grid.Column="2" x:Name="Create" Width="34" Height="32" Padding="0" Click="Create_Click"
                    Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="新建文件夹" AutomationProperties.Name="新建文件夹">
                <FontIcon Glyph="&#xE8F4;" FontSize="16"/>
            </Button>
        </Grid>
        <Grid Grid.Row="3" x:Name="DirectoryHeader" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="Up" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="Up_Click"
                    Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="返回上一级文件夹" ToolTipService.ToolTip="返回上一级">
                <FontIcon Glyph="&#xE72B;" FontSize="13"/>
            </Button>
            <TextBlock x:Name="Location" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Count" Grid.Column="2" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <Grid Grid.Row="4">
            <ListView x:Name="Rows" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Row_Click" KeyDown="Rows_KeyDown"
                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="收藏列表">
                <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,3"/>
                    <Setter Property="MinHeight" Value="34"/>
                </Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BookmarkManagerEntry">
                        <Grid ColumnSpacing="9" Background="Transparent" Tag="{x:Bind}" PointerPressed="Row_PointerPressed" ToolTipService.ToolTip="{x:Bind Hint}" AutomationProperties.HelpText="{x:Bind Hint}">
                            <Grid.ContextFlyout><MenuFlyout>
                                <MenuFlyoutItem Text="在新标签页打开" Tag="{x:Bind}" Click="NewTab_Click" Visibility="{x:Bind LinkActionVisibility}"/>
                                <MenuFlyoutItem Text="编辑或移动…" Tag="{x:Bind}" Click="Edit_Click"/>
                                <MenuFlyoutItem Text="删除…" Tag="{x:Bind}" Click="Remove_Click"/>
                            </MenuFlyout></Grid.ContextFlyout>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ParentPath}" Visibility="{x:Bind DetailVisibility}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Visibility="{x:Bind FolderVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" Margin="4,10" Spacing="8" VerticalAlignment="Top">
                <TextBlock x:Name="Empty" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/>
                <Button x:Name="EmptyImport" Content="从 Chrome 导入…" Click="Import_Click" HorizontalAlignment="Left"/>
            </StackPanel>
            <ScrollViewer x:Name="EditorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" Visibility="Collapsed" Spacing="10" Padding="2,2,4,6" KeyDown="Editor_KeyDown">
                    <TextBlock x:Name="EditorHeading" FontWeight="SemiBold" FontSize="15"/>
                    <TextBox x:Name="EntryName" Header="名称" MaxLength="200"/>
                    <TextBox x:Name="Address" Header="网址" PlaceholderText="https://" Visibility="Collapsed"/>
                    <ComboBox x:Name="ParentFolder" Header="保存到" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="Save" Content="保存" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click"/>
                        <Button Content="取消" Click="CancelEdit_Click"/>
                        <Button x:Name="Delete" Content="删除" Click="Delete_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="5" x:Name="Feedback" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</UserControl>
