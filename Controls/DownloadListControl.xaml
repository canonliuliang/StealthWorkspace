<UserControl
    x:Class="StealthWorkspace.Controls.DownloadListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="360" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="下载" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="清除已结束记录" Click="ClearFinished_Click" HorizontalAlignment="Right" Style="{ThemeResource SubtleButtonStyle}" />
        </Grid>
        <Grid Grid.Row="1" MinHeight="110">
            <TextBlock x:Name="EmptyText" Text="本次会话还没有下载" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="DownloadList" MaxHeight="360" SelectionMode="None" IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="本次会话下载列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding FileName}" />
                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Visibility="{Binding ActionVisibility}" AutomationProperties.Name="下载进度" />
                                <Button Content="加密入库并粉碎原件" Click="StoreDownload_Click" Visibility="{Binding StoreVisibility}" IsEnabled="{Binding CanStore}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{Binding ActionLabel}" AutomationProperties.Name="{Binding ActionName}" Click="PauseResume_Click" Visibility="{Binding ActionVisibility}" />
                                    <Button Content="取消" Click="Cancel_Click" Visibility="{Binding ActionVisibility}" />
                                    <Button Content="在文件夹中显示" Click="ShowFile_Click" Visibility="{Binding CompletedVisibility}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <InfoBar x:Name="ActionError" Grid.Row="2" IsOpen="False" Severity="Warning" />
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock x:Name="RetentionNote" Text="结束会话会清除下载列表。已下载文件可在下载文件夹中找到。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="CurrentFolderButton" Content="打开下载文件夹" Click="OpenFolder_Click" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Grid>
</UserControl>
