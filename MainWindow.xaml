<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="StealthWorkspace.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StealthWorkspace"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="StealthWorkspace"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar Row (Calm & Elegant) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TitleBar
                x:Name="AppTitleBar"
                Grid.Column="0"
                Title="Stealth"
                Subtitle="私密浏览器"
                BackRequested="TitleBar_BackRequested"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <BitmapIconSource UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False" />
                </TitleBar.IconSource>
            </TitleBar>

            <!-- Quiet TitleBar Quick Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,142,0" VerticalAlignment="Center">
                <!-- Calm Ready Indicator (click = open trace cleaner when residue found) -->
                <Border x:Name="StatusBadge"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8,3"
                        Tapped="StatusBadge_Tapped"
                        ToolTipService.ToolTip="底层防截屏/防录屏与易失性沙箱正常运行中">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#10B981" />
                        <TextBlock x:Name="StatusBadgeText" Text="就绪" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <!-- Quick Boss Key (Subtle & Quiet) -->
                <Button Click="QuickBossKey_Click"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="老板键避险 (Ctrl + Alt + B)"
                        Padding="6,4">
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- Quick Lock -->
                <Button Click="QuickLockBtn_Click"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="锁定工作区"
                        Padding="6,4">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="1050"
            CompactModeThresholdWidth="500"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="浏览器" Tag="browser">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="媒体库" Tag="vault">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="播放器" Tag="player">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="痕迹清理" Tag="cleaner">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="NavFrame" Navigated="NavFrame_Navigated" />
        </NavigationView>

        <!-- Camouflage Windows Update Screen (BossKeyAction == 2) -->
        <Grid x:Name="CamouflageOverlay"
              Grid.RowSpan="2"
              Background="#001830"
              Visibility="Collapsed"
              KeyDown="CamouflageOverlay_KeyDown"
              Canvas.ZIndex="100"
              IsTabStop="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="50" Height="50" Foreground="White" />
                <TextBlock Text="正在配置 Windows 更新&#x0a;请勿关闭计算机，这需要一些时间..."
                           FontSize="18"
                           FontWeight="Normal"
                           Foreground="White"
                           TextAlignment="Center"
                           LineHeight="28" />
                <TextBlock Text="按 Esc 退出伪装"
                           FontSize="10"
                           Foreground="#40FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
