<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthWorkspace.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyDown="Page_KeyDown"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Invoked="ImageNavigation_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="ImageNavigation_Invoked" />
        <KeyboardAccelerator Key="Home" Invoked="ImageNavigation_Invoked" />
        <KeyboardAccelerator Key="End" Invoked="ImageNavigation_Invoked" />
        <KeyboardAccelerator Key="W" Invoked="ImageLayout_Invoked" />
        <KeyboardAccelerator Key="Number0" Invoked="ImageLayout_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Floating Top Overlay Bar -->
        <Border Grid.Row="0" Background="{ThemeResource StealthSurfaceBrush}" Padding="16,10" Canvas.ZIndex="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back to Vault Button -->
                <Button Grid.Column="0" Click="BackBtn_Click" AutomationProperties.Name="返回媒体库" Style="{ThemeResource SubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="White" />
                        <TextBlock Text="返回" Foreground="White" FontWeight="Medium" />
                    </StackPanel>
                </Button>

                <!-- Media Title & Info Badge -->
                <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center" Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaTitleText" Text="未选择媒体" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="MediaFormatBadge" Grid.Column="1" Text="MP4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Action Controls (Speed, Stretch, Boss Key) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <DropDownButton x:Name="SpeedButton" Content="1.0x" AutomationProperties.Name="播放速度" Style="{ThemeResource SubtleButtonStyle}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="0.75x" Click="Speed_Click" Tag="0.75" />
                                <MenuFlyoutItem Text="1.0x" Click="Speed_Click" Tag="1.0" />
                                <MenuFlyoutItem Text="1.25x" Click="Speed_Click" Tag="1.25" />
                                <MenuFlyoutItem Text="1.5x" Click="Speed_Click" Tag="1.5" />
                                <MenuFlyoutItem Text="2.0x" Click="Speed_Click" Tag="2.0" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button AutomationProperties.Name="画面比例切换" x:Name="StretchButton" Click="StretchToggle_Click" Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="画面比例切换">
                        <FontIcon Glyph="&#xE799;" FontSize="13" Foreground="White" />
                    </Button>

                    <Button AutomationProperties.Name="按窗口宽度阅读长图 (W)" x:Name="ImageFitButton" Content="适应宽度" Visibility="Collapsed" Click="ImageWidthFit_Click" Foreground="White" ToolTipService.ToolTip="按窗口宽度阅读长图 (W)" Style="{ThemeResource SubtleButtonStyle}" />

                    <!-- Instant Boss Key -->
                    <Button AutomationProperties.Name="快速最小化 (Ctrl + Alt + B)" Click="PlayerBossKey_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="8,4" ToolTipService.ToolTip="快速最小化 (Ctrl + Alt + B)">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Media Stage Area -->
        <Grid Grid.Row="1">
            <!-- WinUI Video Player -->
            <MediaPlayerElement x:Name="PlayerElement"
                                AreTransportControlsEnabled="True"
                                AutoPlay="True"
                                Stretch="Uniform"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

            <Grid x:Name="PlayerEmptyNotice" Background="{ThemeResource StealthCanvasBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24" Spacing="16">
                    <Border Background="{ThemeResource StealthBrandSubtleBrush}" Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="{ThemeResource StealthBrandBrush}" />
                    </Border>
                    <TextBlock Text="选择一份媒体开始" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="在媒体库中打开图片或视频，在这里专注观看。" Style="{StaticResource StealthCaptionStyle}" TextAlignment="Center" />
                    <Button Content="打开媒体库" Click="OpenLibrary_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="20,10" />
                </StackPanel>
            </Grid>

            <!-- Image Viewer for Encrypted Photos -->
            <ScrollViewer x:Name="ImageContainer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled"
                          MinZoomFactor="1" MaxZoomFactor="16" ViewChanged="ImageContainer_ViewChanged"
                          SizeChanged="ImageContainer_SizeChanged" IsTabStop="True" AutomationProperties.Name="图片阅读区域"
                          Visibility="Collapsed">
                <Grid x:Name="ImageStage" Padding="12">
                    <Image x:Name="ImageViewer" Stretch="Uniform" DoubleTapped="ImageViewer_DoubleTapped"
                           PointerPressed="ImageViewer_PointerPressed" PointerMoved="ImageViewer_PointerMoved"
                           PointerReleased="ImageViewer_PointerReleased" PointerCanceled="ImageViewer_PointerReleased"
                           PointerCaptureLost="ImageViewer_PointerCaptureLost" />
                </Grid>
            </ScrollViewer>

            <!-- Loading Spinner -->
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="52" Height="52"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

            <!-- Playback error / codec hint -->
            <InfoBar x:Name="PlaybackInfoBar"
                     IsOpen="False"
                     Severity="Error"
                     Title="无法播放"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Margin="16,16,16,0" />
        </Grid>
        <Border x:Name="ImageNavigationBar" Grid.Row="2" Visibility="Collapsed" Background="{ThemeResource StealthSurfaceBrush}" Padding="12,10" RequestedTheme="Dark">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="← / → 切换图片" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="PreviousImageButton" Click="PreviousImage_Click" AutomationProperties.Name="上一张图片" ToolTipService.ToolTip="上一张（←）" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="40"><FontIcon Glyph="&#xE76B;" FontSize="16" /></Button>
                    <TextBlock x:Name="ImagePositionText" Text="1 / 1" MinWidth="72" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="NextImageButton" Click="NextImage_Click" AutomationProperties.Name="下一张图片" ToolTipService.ToolTip="下一张（→）" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="40"><FontIcon Glyph="&#xE76C;" FontSize="16" /></Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Click="ImageZoomOut_Click" AutomationProperties.Name="缩小图片" ToolTipService.ToolTip="缩小" Style="{ThemeResource SubtleButtonStyle}" Width="36"><FontIcon Glyph="&#xE738;" FontSize="14" /></Button>
                    <Button AutomationProperties.Name="显示整张图片 (0)" x:Name="ImageZoomResetButton" Content="适应" Click="ImageFit_Click" ToolTipService.ToolTip="显示整张图片 (0)" Style="{ThemeResource SubtleButtonStyle}" MinWidth="60" />
                    <Button Click="ImageZoomIn_Click" AutomationProperties.Name="放大图片" ToolTipService.ToolTip="放大" Style="{ThemeResource SubtleButtonStyle}" Width="36"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
