<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthWorkspace.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:StealthWorkspace.Services"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16" Background="{ThemeResource StealthCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="痕迹清理" Style="{StaticResource StealthPageTitleStyle}" />
                <TextBlock Text="先扫描，再选择要清理的活动记录与缓存。" Style="{StaticResource StealthCaptionStyle}" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource StealthBrandSubtleBrush}" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatsBadgeText" Text="待扫描" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource StealthBrandBrush}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ScanBtn" Content="重新扫描" Click="ScanBtn_Click" Padding="14,8" />
                    <Button x:Name="CleanBtn" Content="清理选中项" Style="{ThemeResource AccentButtonStyle}" Click="CleanBtn_Click" Padding="18,8" />
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PresetPrivacyBtn" Content="推荐项目" Click="PresetPrivacyBtn_Click" Style="{ThemeResource SubtleButtonStyle}" FontSize="13" />
                    <Button x:Name="SelectAllBtn" Content="全选" Click="SelectAllBtn_Click" Style="{ThemeResource SubtleButtonStyle}" FontSize="13" />
                    <Button x:Name="DeselectAllBtn" Content="取消全选" Click="DeselectAllBtn_Click" Style="{ThemeResource SubtleButtonStyle}" FontSize="13" />
                </StackPanel>
                <ProgressRing x:Name="OpProgressRing" Grid.Column="1" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
            </Grid>
            <Expander Header="高级清理选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="RestartExplorerCheck" IsChecked="False" FontSize="13" AutomationProperties.Name="允许短暂重启资源管理器，以释放占用的缩略图缓存">
                        <TextBlock Text="允许短暂重启资源管理器，以释放占用的缩略图缓存。" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox x:Name="DeepTempCheck" IsChecked="False" Checked="DeepTempCheck_Changed" Unchecked="DeepTempCheck_Changed" FontSize="13" AutomationProperties.Name="深度清理临时目录，包含 24 小时内的文件及子目录">
                        <TextBlock Text="深度清理临时目录，包含 24 小时内的文件及子目录。" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox x:Name="SecureShredCheck" IsChecked="False" FontSize="13" AutomationProperties.Name="删除前尝试覆写文件，耗时更长，无法保证数据不可恢复">
                        <TextBlock Text="删除前尝试覆写文件，耗时更长；无法保证所有存储介质上的数据不可恢复。" TextWrapping="Wrap" />
                    </CheckBox>
                </StackPanel>
            </Expander>
        </StackPanel>

        <ListView x:Name="CleanerListView" Grid.Row="3" SelectionMode="None"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="可清理的活动记录与缓存">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:CleanerItem">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="28" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Name}" />
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{ThemeResource StealthBrandSubtleBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource StealthBrandBrush}" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind GroupName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplaySize, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource StealthBrandBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                </Grid>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource StealthCaptionStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="查看明细" Tag="{x:Bind}" IsEnabled="{x:Bind HasDetails, Mode=OneWay}" Click="DetailsBtn_Click" Style="{ThemeResource SubtleButtonStyle}" FontSize="12" ToolTipService.ToolTip="查看本次扫描到的文件或注册表条目样本" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="SummaryText" Grid.Row="4" Text="正在准备扫描…" Style="{StaticResource StealthCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
