<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthWorkspace.Pages.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:StealthWorkspace.Models"
    AllowDrop="True"
    DragOver="VaultPage_DragOver"
    DragLeave="VaultPage_DragLeave"
    Drop="VaultPage_Drop"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20" Background="{ThemeResource StealthCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Stats -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <StackPanel Spacing="4">
                    <TextBlock Text="媒体库" Style="{StaticResource StealthPageTitleStyle}" />
                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="AES-256-GCM 分块加密 · 播放全程内存解密"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <TextBlock Text="加密保险箱" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatsSummaryText" Text="图片与视频，保存在你的加密空间。"
                           Style="{StaticResource StealthCaptionStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="ImportButton" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="导入文件"
                    Style="{ThemeResource AccentButtonStyle}" Click="ImportFile_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="导入文件" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索文件名" QueryIcon="Find" AutomationProperties.Name="搜索媒体文件"
                            TextChanged="SearchBox_TextChanged" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MediaFilter" SelectedIndex="0" SelectionChanged="MediaFilter_SelectionChanged"
                          AutomationProperties.Name="媒体类型" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="全部媒体" />
                    <ComboBoxItem Content="视频" />
                    <ComboBoxItem Content="图片" />
                </ComboBox>
                <ComboBox x:Name="MediaSort" Grid.Column="1" SelectedIndex="0" SelectionChanged="MediaFilter_SelectionChanged"
                          AutomationProperties.Name="媒体排序">
                    <ComboBoxItem Content="最新导入" />
                    <ComboBoxItem Content="文件名" />
                    <ComboBoxItem Content="体积从大到小" />
                </ComboBox>
                <ToggleButton x:Name="BatchMode" Grid.Column="2" Content="多选" Click="BatchMode_Click" AutomationProperties.Name="多选管理" />
                <DropDownButton x:Name="LibraryActions" Grid.Column="3" Content="更多">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="PlayButton" Text="打开选中媒体" Icon="Play" Click="PlaySelected_Click" />
                            <MenuFlyoutItem x:Name="RenameButton" Text="重命名" Icon="Rename" Click="RenameSelected_Click" />
                            <MenuFlyoutItem x:Name="ExportButton" Text="导出副本" Icon="Share" Click="ExportSelected_Click" />
                            <MenuFlyoutItem x:Name="DeleteButton" Text="粉碎删除选中项" Icon="Delete" Click="DeleteSelected_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="ShredOriginalCheckBox" Text="导入后粉碎原件" IsChecked="False" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
            <StackPanel x:Name="BatchActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" />
                <Button Content="全选" Click="SelectAll_Click" />
                <Button x:Name="BatchExportButton" Content="导出到文件夹" Click="ExportSelected_Click" />
                <Button x:Name="BatchDeleteButton" Content="粉碎删除" Click="DeleteSelected_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Media Grid / Cards Surface -->
        <Grid Grid.Row="2">
            <!-- Empty Placeholder -->
            <Border x:Name="EmptyNotice"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Spacing="12">
                    <Grid Width="56" Height="56" HorizontalAlignment="Center">
                        <Ellipse Fill="{ThemeResource StealthBrandSubtleBrush}" />
                        <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{ThemeResource StealthBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="EmptyTitleText" Text="这里还没有媒体" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDescriptionText" Text="拖入图片或视频，或点击「导入文件」，开始整理你的私人收藏。" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{StaticResource StealthCaptionStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Drag & Drop Overlay Indicator -->
            <Border x:Name="DragOverlay"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Visibility="Collapsed"
                    Canvas.ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="松开鼠标，加密导入" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- Media Items GridView -->
            <GridView x:Name="MediaGridView"
                      SelectionMode="Single"
                      SelectionChanged="MediaGridView_SelectionChanged"
                      DoubleTapped="MediaGridView_DoubleTapped"
                      PreviewKeyDown="MediaGridView_KeyDown"
                      ContainerContentChanging="MediaGridView_ContainerContentChanging"
                      AutomationProperties.Name="媒体文件"
                      Padding="0,4,0,0">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="CornerRadius" Value="12" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:VaultItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Width="168"
                                Height="188"
                                Padding="10">
                            <!-- Right Click Context Menu -->
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="打开媒体" Icon="Play" Tag="{x:Bind Id}" Click="FlyoutPlay_Click" />
                                    <MenuFlyoutItem Text="重命名" Icon="Rename" Tag="{x:Bind Id}" Click="FlyoutRename_Click" />
                                    <MenuFlyoutItem Text="解密导出至磁盘" Icon="Share" Tag="{x:Bind Id}" Click="FlyoutExport_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="彻底粉碎删除" Icon="Delete" Tag="{x:Bind Id}" Click="FlyoutDelete_Click" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>

                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Card Header: Icon & Media Badge -->
                                <Grid Grid.Row="0">
                                    <Border CornerRadius="6" Background="{ThemeResource StealthBrandSubtleBrush}">
                                        <Grid>
                                            <FontIcon Glyph="{x:Bind DisplayIconGlyph}" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="MediaThumbnail" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind FileExtension}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Card Center: Title -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{x:Bind OriginalFileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                               MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind OriginalFileName, Mode=OneWay}" />
                                </StackPanel>

                                <!-- Card Footer: Size & Date -->
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{x:Bind DisplaySize}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="Medium" HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind DisplayDuration, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap"
                       Style="{StaticResource StealthCaptionStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="OperationProgress" Visibility="Collapsed" Spacing="4">
                <ProgressBar x:Name="ImportProgressBar" AutomationProperties.Name="文件处理进度" />
                <Button x:Name="CancelImportButton" Content="取消导入" Click="CancelImport_Click" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="FailureActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button Content="重试失败项" Click="RetryFailed_Click" />
                <Button Content="查看失败详情" Click="ImportDetails_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
