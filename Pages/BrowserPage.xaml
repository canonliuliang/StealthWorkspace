<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StealthWorkspace.Pages.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StealthWorkspace.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="SessionNotice" IsOpen="False" />

        <TabView x:Name="BrowserTabView" Grid.Row="1"
                 AddTabButtonClick="BrowserTabView_AddTabButtonClick"
                 TabCloseRequested="BrowserTabView_TabCloseRequested"
                 SelectionChanged="BrowserTabView_SelectionChanged"
                 IsAddTabButtonVisible="True"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 TabWidthMode="Equal"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch">

            <TabView.KeyboardAccelerators>
                <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="ReopenTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="SwitchTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="SwitchTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="A" Modifiers="Control,Shift" Invoked="SearchTabsAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number7" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number8" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="Number9" Modifiers="Control" Invoked="NumberedTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddressAccelerator_Invoked" />
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccelerator_Invoked" />
                <KeyboardAccelerator Key="F3" Invoked="FindAccelerator_Invoked" />
                <KeyboardAccelerator Key="F3" Modifiers="Shift" Invoked="FindAccelerator_Invoked" />
                <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="BookmarkAccelerator_Invoked" />
                <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
                <KeyboardAccelerator Key="W" Modifiers="Control,Shift" Invoked="BurnAllTabsAccelerator_Invoked" />
            </TabView.KeyboardAccelerators>

            <TabView.TabStripHeader>
                <Button x:Name="TabSearchButton" Margin="8,0,4,0" Padding="10,0" Height="{ThemeResource TabViewItemMinHeight}" VerticalAlignment="Bottom"
                        VerticalContentAlignment="Center" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="搜索标签页" ToolTipService.ToolTip="搜索标签页 (Ctrl+Shift+A)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><FontIcon Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" /><TextBlock x:Name="TabCountText" Text="1" FontSize="{ThemeResource TabViewItemHeaderFontSize}" VerticalAlignment="Center" /></StackPanel>
                    <Button.Flyout><Flyout x:Name="TabListFlyout" Opening="TabListFlyout_Opening" Opened="TabListFlyout_Opened" Closed="TabListFlyout_Closed">
                        <Grid Width="340" MaxHeight="480" RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <SelectorBar x:Name="TabSearchScope" SelectionChanged="TabSearchScope_SelectionChanged" AutomationProperties.Name="标签页范围">
                                <SelectorBarItem x:Name="OpenTabsSection" Text="已打开" IsSelected="True" />
                                <SelectorBarItem x:Name="ClosedTabsSection" Text="最近关闭" ToolTipService.ToolTip="选择要恢复的标签页 (Ctrl+Shift+T 可恢复上一个)" />
                            </SelectorBar>
                            <TextBox x:Name="TabSearchBox" Grid.Row="1" PlaceholderText="搜索标签标题或网址" AutomationProperties.Name="搜索标签标题或网址" TextChanged="TabSearchBox_TextChanged" KeyDown="TabSearchBox_KeyDown" />
                            <ListView x:Name="TabSearchResults" Grid.Row="2" MaxHeight="350" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TabSearchResults_ItemClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="打开的标签页">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,4" /></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="models:BrowserTabSearchItem">
                                    <Grid ColumnSpacing="10" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <IconSourceElement IconSource="{x:Bind Icon}" Width="16" Height="16" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Address}">
                                            <TextBlock Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Address}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Visibility="{x:Bind CloseVisibility}" Click="CloseSearchTab_Click" Style="{ThemeResource SubtleButtonStyle}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind CloseLabel}" ToolTipService.ToolTip="关闭标签页"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="TabSearchEmpty" Grid.Row="3" Text="没有匹配的标签页" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" Margin="8" />
                        </Grid>
                    </Flyout></Button.Flyout>
                </Button>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Button x:Name="EndSessionBtn" Click="BurnAllTabs_Click"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Height="{ThemeResource TabViewItemMinHeight}" Padding="10,0" Margin="4,0,8,0" VerticalAlignment="Bottom"
                        HorizontalAlignment="Left" VerticalContentAlignment="Center"
                        AutomationProperties.Name="结束并清除会话"
                        ToolTipService.ToolTip="关闭所有标签页并清除本次浏览数据 (Ctrl + Shift + W)">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="结束会话" FontSize="{ThemeResource TabViewItemHeaderFontSize}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </TabView.TabStripFooter>
        </TabView>
        <Grid x:Name="DownloadHosts" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Page>
